# EcoSphere Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is in .gitignore.

# ── xAI Grok API ─────────────────────────────────────────────────────────
GROK_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.5
GROK_BASE_URL=https://api.x.ai/v1

# ── Optional: override Grok timeout (seconds, default 30) ────────────────
# GROK_TIMEOUT=30

# ── Optional: Grok response cache TTL (seconds, default 3600) ────────────
# GROK_CACHE_TTL=3600
