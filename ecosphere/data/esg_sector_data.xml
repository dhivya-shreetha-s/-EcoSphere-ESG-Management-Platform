<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Example sector seeds. noupdate="1" preserves any admin changes post-install.
        Teams should add or edit sectors in the Admin UI after installation.
        -->

        <record id="esg_sector_it" model="esg.sector">
            <field name="name">Information Technology</field>
            <field name="code">IT</field>
            <field name="sequence">10</field>
            <field name="description">Software development, infrastructure, and digital operations.</field>
        </record>

        <record id="esg_sector_ops" model="esg.sector">
            <field name="name">Operations</field>
            <field name="code">OPS</field>
            <field name="sequence">20</field>
            <field name="description">Logistics, supply chain, facilities, and manufacturing.</field>
        </record>

        <record id="esg_sector_hr" model="esg.sector">
            <field name="name">Human Resources</field>
            <field name="code">HR</field>
            <field name="sequence">30</field>
            <field name="description">People, culture, learning and development.</field>
        </record>

        <record id="esg_sector_finance" model="esg.sector">
            <field name="name">Finance &amp; Accounting</field>
            <field name="code">FIN</field>
            <field name="sequence">40</field>
            <field name="description">Financial reporting, compliance, and procurement.</field>
        </record>

        <record id="esg_sector_sales" model="esg.sector">
            <field name="name">Sales &amp; Marketing</field>
            <field name="code">SALES</field>
            <field name="sequence">50</field>
            <field name="description">Revenue generation, customer engagement, and brand.</field>
        </record>

    </data>
</odoo>
