# EcoSphere — Odoo config template
# Copy to odoo.conf and fill in your values.
# Do NOT commit odoo.conf if it contains your DB password.

[options]
addons_path = /path/to/odoo/addons,/path/to/ecosphere/..
db_host = localhost
db_port = 5432
db_name = ecosphere_dev
db_user = odoo
db_password = your_db_password_here
http_port = 8069
log_level = info

# Uncomment for dev (auto-reload on file change):
# dev = all
