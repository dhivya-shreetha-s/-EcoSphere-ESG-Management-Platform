<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── esg.recommendation list view ──────────────────────── -->
        <record id="view_esg_recommendation_list" model="ir.ui.view">
            <field name="name">esg.recommendation.list</field>
            <field name="model">esg.recommendation</field>
            <field name="arch" type="xml">
                <list string="ESG Action Items"
                      decoration-danger="priority == 'high' and state == 'open'"
                      decoration-muted="state in ('done', 'dismissed')">
                    <field name="title"/>
                    <field name="priority"/>
                    <field name="scope"/>
                    <field name="employee_id" optional="show"/>
                    <field name="department_id" optional="show"/>
                    <field name="metric_id"/>
                    <field name="due_date"/>
                    <field name="state"/>
                    <field name="is_ai_generated" string="AI" widget="boolean"/>
                    <field name="xp_reward" string="XP"/>
                </list>
            </field>
        </record>

        <!-- ── esg.csr.event list view ───────────────────────────── -->
        <record id="view_esg_csr_event_list" model="ir.ui.view">
            <field name="name">esg.csr.event.list</field>
            <field name="model">esg.csr.event</field>
            <field name="arch" type="xml">
                <list string="CSR Events"
                      decoration-muted="state in ('completed', 'cancelled')">
                    <field name="name"/>
                    <field name="event_date"/>
                    <field name="location"/>
                    <field name="category_id"/>
                    <field name="organizer_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="registration_count" string="Registered"/>
                    <field name="max_participants"/>
                    <field name="xp_award" string="XP"/>
                    <field name="state"/>
                    <button name="action_approve" type="object" string="Approve"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"
                            groups="ecosphere.group_esg_manager"
                            class="btn-sm btn-primary"/>
                </list>
            </field>
        </record>

        <!-- ── esg.csr.event form view ───────────────────────────── -->
        <record id="view_esg_csr_event_form" model="ir.ui.view">
            <field name="name">esg.csr.event.form</field>
            <field name="model">esg.csr.event</field>
            <field name="arch" type="xml">
                <form string="CSR / Sustainability Event">
                    <header>
                        <button name="action_approve" type="object"
                                string="Approve"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"
                                groups="ecosphere.group_esg_manager"
                                class="btn-primary"/>
                        <button name="action_complete" type="object"
                                string="Mark Completed"
                                attrs="{'invisible': [('state', '!=', 'approved')]}"
                                groups="ecosphere.group_esg_manager"/>
                        <button name="action_cancel" type="object"
                                string="Cancel"
                                attrs="{'invisible': [('state', 'in', ['completed', 'cancelled'])]}"
                                groups="ecosphere.group_esg_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,approved,completed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="event_date"/>
                                <field name="location"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="organizer_id"/>
                                <field name="department_id"/>
                                <field name="max_participants"/>
                                <field name="xp_award" string="XP Per Participant"/>
                                <field name="volunteer_hours" readonly="1"/>
                                <field name="registration_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Describe this event…"/>
                        <notebook>
                            <page string="Registrations">
                                <field name="registration_ids">
                                    <list>
                                        <field name="employee_id"/>
                                        <field name="state"/>
                                        <field name="hours_attended"/>
                                        <field name="xp_granted" string="XP Granted"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ── Window actions ────────────────────────────────────── -->
        <record id="action_esg_recommendation_list" model="ir.actions.act_window">
            <field name="name">ESG Action Items</field>
            <field name="res_model">esg.recommendation</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_esg_csr_event_list" model="ir.actions.act_window">
            <field name="name">CSR Events</field>
            <field name="res_model">esg.csr.event</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No CSR events yet. Managers can create and approve events.
                    Employees will see approved events to register for.
                </p>
            </field>
        </record>

    </data>
</odoo>
