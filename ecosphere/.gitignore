*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.whl
.venv/
venv/
env/
.env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Node (if added for any tooling)
node_modules/
