<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
        ================================================================
        CLIENT ACTIONS DEFINITIONS
        Binds the OWL client action tags to Odoo actions.
        ================================================================
        -->

        <record id="action_employee_dashboard" model="ir.actions.client">
            <field name="name">ESG Dashboard</field>
            <field name="tag">ecosphere.action_employee_dashboard</field>
        </record>

        <record id="action_manager_dashboard" model="ir.actions.client">
            <field name="name">Department ESG Summary</field>
            <field name="tag">ecosphere.action_manager_dashboard</field>
        </record>

        <record id="action_admin_dashboard" model="ir.actions.client">
            <field name="name">Executive ESG Dashboard</field>
            <field name="tag">ecosphere.action_admin_dashboard</field>
        </record>

        <!--
        ================================================================
        TOP-LEVEL ESG APPLICATION MENU
        Native Odoo group-based routing (Section 6 of the master prompt).
        ================================================================
        -->

        <menuitem
            id="menu_ecosphere_root"
            name="EcoSphere"
            sequence="95"
            groups="ecosphere.group_esg_employee"/>

        <!-- ── Dashboard Client Actions (scoped by group) ────────── -->
        <menuitem
            id="menu_ecosphere_dashboard_emp"
            name="Dashboard"
            parent="menu_ecosphere_root"
            sequence="10"
            action="action_employee_dashboard"
            groups="ecosphere.group_esg_employee"/>

        <menuitem
            id="menu_ecosphere_dashboard_mgr"
            name="Manager Dashboard"
            parent="menu_ecosphere_root"
            sequence="11"
            action="action_manager_dashboard"
            groups="ecosphere.group_esg_manager"/>

        <menuitem
            id="menu_ecosphere_dashboard_adm"
            name="Admin Dashboard"
            parent="menu_ecosphere_root"
            sequence="12"
            action="action_admin_dashboard"
            groups="ecosphere.group_esg_admin"/>

        <!-- ── Events (shared list view) ────────────────────────── -->
        <menuitem
            id="menu_ecosphere_events"
            name="CSR Events"
            parent="menu_ecosphere_root"
            sequence="20"
            action="action_esg_csr_event_list"
            groups="ecosphere.group_esg_employee"/>

        <!-- ── Alerts Center (shared list view) ──────────────────── -->
        <menuitem
            id="menu_ecosphere_alerts"
            name="Alerts Center"
            parent="menu_ecosphere_root"
            sequence="30"
            action="action_esg_alert_list"
            groups="ecosphere.group_esg_employee"/>

        <!-- ── Settings Menu (admin only) ────────────────────────── -->
        <menuitem
            id="menu_ecosphere_settings"
            name="Settings"
            parent="menu_ecosphere_root"
            sequence="90"
            groups="ecosphere.group_esg_admin"/>

        <menuitem
            id="menu_ecosphere_sectors"
            name="Sectors"
            parent="menu_ecosphere_settings"
            sequence="10"
            action="action_esg_sector_list"
            groups="ecosphere.group_esg_admin"/>

        <menuitem
            id="menu_ecosphere_categories"
            name="ESG Categories &amp; Weights"
            parent="menu_ecosphere_settings"
            sequence="20"
            action="action_esg_category_list"
            groups="ecosphere.group_esg_admin"/>

        <menuitem
            id="menu_ecosphere_metrics"
            name="Metrics"
            parent="menu_ecosphere_settings"
            sequence="30"
            action="action_esg_metric_list"
            groups="ecosphere.group_esg_admin"/>

        <menuitem
            id="menu_ecosphere_data_sources"
            name="Data Sources"
            parent="menu_ecosphere_settings"
            sequence="40"
            action="action_esg_data_source_list"
            groups="ecosphere.group_esg_admin"/>

    </data>
</odoo>
