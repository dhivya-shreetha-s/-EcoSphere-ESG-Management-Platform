<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ecosphere.EsgEmployeeDashboard" owl="1">
        <div class="esg-dashboard-container p-4" style="background-color: #f8fafc; min-height: 100vh; font-family: inherit;">
            
            <!-- Top Header Summary Card -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded p-4 d-flex flex-row align-items-center justify-content-between bg-white">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-indigo-50 d-flex align-items-center justify-content-center me-3" style="width: 64px; height: 64px;">
                                <i class="fa fa-user-circle fs-2 text-indigo-500"/>
                            </div>
                            <div>
                                <h4 class="m-0 fw-bold text-slate-800" t-out="state.employee.name || 'ESG Employee'"/>
                                <span class="text-muted" t-out="(state.employee.job_title || 'Sustainability Champion') + ' | ' + (state.employee.department_id ? state.employee.department_id[1] : 'IT Operations')"/>
                            </div>
                        </div>
                        <div class="d-flex gap-4">
                            <div class="text-center">
                                <span class="d-block fs-4 fw-bold text-indigo-600" t-out="state.xp || 0"/>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Sustainability XP</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Score and Main breakdown -->
            <div class="row mb-4">
                <!-- Left: Circular overall ring -->
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="card shadow-sm border-0 rounded p-4 bg-white h-100 d-flex flex-column align-items-center justify-content-center">
                        <EsgScoreRing score="state.score.score_overall" label="'My Overall Score'"/>
                    </div>
                </div>
                <!-- Right: Category rollups progress bars -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0 rounded p-4 bg-white h-100">
                        <h5 class="fw-bold text-slate-800 mb-3"><i class="fa fa-tachometer me-2"/>My ESG Contribution</h5>
                        <EsgCategoryChart envScore="state.score.score_env" socialScore="state.score.score_social" govScore="state.score.score_gov"/>
                        <div t-if="state.score.explanation" class="mt-3 p-3 rounded bg-slate-50 border border-light">
                            <small class="text-slate-600 italic"><i class="fa fa-magic text-indigo-500 me-2"/>Grok Explanation: <span t-out="state.score.explanation"/></small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid: Action Items & Upcoming Events -->
            <div class="row">
                <!-- Action Items -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 rounded p-4 bg-white h-100">
                        <h5 class="fw-bold text-slate-800 mb-3"><i class="fa fa-list-check text-indigo-500 me-2"/>My ESG Action Items</h5>
                        <div t-if="state.recommendations.length == 0" class="text-center py-4">
                            <i class="fa fa-circle-check fs-2 text-emerald-400 mb-2"/>
                            <p class="text-muted m-0">All action items completed! Great job.</p>
                        </div>
                        <t t-else="">
                            <t t-foreach="state.recommendations" t-as="rec" t-key="rec.id">
                                <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center hover-bg-slate-50 shadow-sm" style="background-color: #f8fafc;">
                                    <div>
                                        <h6 class="fw-bold text-slate-800 m-0" t-out="rec.title"/>
                                        <p class="text-muted m-0" style="font-size: 0.85rem;" t-out="rec.description"/>
                                    </div>
                                    <button class="btn btn-sm btn-indigo text-nowrap" t-on-click="() => this.markActionDone(rec.id)">
                                        <i class="fa fa-check me-1"/>Done
                                    </button>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- Events -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 rounded p-4 bg-white h-100">
                        <h5 class="fw-bold text-slate-800 mb-3"><i class="fa fa-calendar-check text-emerald-500 me-2"/>Sustainability Events</h5>
                        <div t-if="state.events.length == 0" class="text-center py-4">
                            <i class="fa fa-calendar-xmark fs-2 text-muted mb-2"/>
                            <p class="text-muted m-0">No upcoming events listed.</p>
                        </div>
                        <t t-else="">
                            <t t-foreach="state.events" t-as="event" t-key="event.id">
                                <div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center hover-bg-slate-50 shadow-sm" style="background-color: #f8fafc;">
                                    <div>
                                        <h6 class="fw-bold text-slate-800 m-0" t-out="event.name"/>
                                        <small class="text-muted"><i class="fa fa-clock me-1"/>Date: <span t-out="event.event_date"/></small>
                                        <p class="text-muted m-0" style="font-size: 0.85rem;" t-out="event.location"/>
                                    </div>
                                    <button class="btn btn-sm btn-emerald text-nowrap" t-on-click="() => this.registerEvent(event.id)">
                                        <i class="fa fa-calendar-plus me-1"/>Register
                                    </button>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Floating AI chat -->
            <EsgAiChatPanel role="'employee'"/>

        </div>
    </t>
</templates>
